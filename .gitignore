__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Test coverage
.coverage
htmlcov/

# Mac system files
.DS_Store
.AppleDouble
.LSOverride

# IDE files
.vscode/
.idea/
*.swp
*.swo

# Packet captures - sample PCAPs kept locally, not in the repo
*.pcap
